{"fen":"rnbakabnr/9/1c5c1/p1p1p1p1p/9/9/P1P1P1P1P/1C5C1/9/RNBAKABNR w - - 0 1","win":"*","moves":[{"m":"h2e2","cn":"炮二平五","ch":[{"m":"b7e7","cn":"炮2平5","ch":[{"m":"h0g2","cn":"马二进三","ch":[{"m":"b9c7","cn":"马2进3","ch":[{"m":"i0h0","cn":"车一平二","ch":[{"m":"h9g7","cn":"马8进7","ch":[{"m":"h0h6","cn":"车二进六","ch":[{"m":"a9b9","cn":"车1平2","c":"仅几个回合，就显示出这种黑方布局与以往常见的列炮走法不同。例如小列手炮在黑第2回合即跳马8进7开展左翼，以应付红右车过河进攻，而大列手炮在黑第3回合多走炮8平一7再跳边马。 如图，黑方阵式有两个特点：一是右车快，二是左马弱，今后发展的关键在于如何发挥右车威力，并处理好左马的弊病。","ch":[{"m":"b2d2","cn":"炮八平六","ch":[{"m":"f9e8","cn":"士6进5","ch":[{"m":"b0c2","cn":"马八进七","ch":[{"m":"g9i7","cn":"象7进9","ch":[{"m":"h6g6","cn":"车二平三","ch":[{"m":"i9g9","cn":"车9平7","ch":[{"m":"a0a1","cn":"车九进一","ch":[{"m":"h7h5","cn":"炮8进2","ch":[{"m":"c3c4","cn":"兵七进一","ch":[{"m":"h5d5","cn":"炮8平4","ch":[{"m":"a1f1","cn":"车九平四","ch":[{"m":"b9b3","cn":"车2进6","ch":[{"m":"f0e1","cn":"仕四进五","ch":[{"m":"b3c3","cn":"车2平3","c":"至此，黑右车牵制红三个强子，左马暂时受压不要紧，只要退一步炮赶走红车即可松绑，故黑方局型满意。其中红第6回合先走车二平三逼退黑马较好些，当黑飞边象后，第7回合就没必要再走这步车吃卒了，可改兵七进一为宜。第8回合还是应走兵七进一活马。 这局棋结果黑胜。在以后的对局中，红第5回合改跳正马，加强对攻力量。"}]}]}]}]}]}]}]}]}]}]}]}]}]},{"m":"b0c2","cn":"马八进七","ch":[{"m":"c6c5","cn":"卒3进1","ch":[{"m":"a0b0","cn":"车九平八","ch":[{"m":"b9b3","cn":"车2进6","c":"黑挺卒是事先经过研究，具有深远意义的棋，一方是借鉴顺炮局中“右马活跃，左马归心”的构思，运用到列炮条件下，准备红车吃卒即马退窝心；另一方是红右车过河作战，威胁黑左翼弱马，在右翼施展反击。","ch":[{"m":"g3g4","cn":"兵三进一","ch":[{"m":"i9i8","cn":"车9进1","ch":[{"m":"h6g6","cn":"车二平三","ch":[{"m":"g7e8","cn":"马7退5","ch":[{"m":"g4g5","cn":"兵三进一","ch":[{"m":"i8f8","cn":"车9平6","c":"黑左车横车是一种罕见的走法，平肋后可监视红三路马、兵的动向，并伺机前伸与右车暗中配合，有左右夹击的意图。通常列炮局多出直车，而现在这种横车用法比较灵活。 如图是列炮窝心马的典型局面，黑方优先发展右翼子力，已显出一定优势，左翼则有肋车占据要津，攻守两利。唯一弊病是窝心马，但红方尚无针对它的有效攻击手段，至此，红如平炮兑车，即炮八平九，则会演变成车2平3，车八进二，卒3进1，士六进五，车3平4，车八进四，卒3进1，马七退六，马3进4，车八平六，马5进3，把窝心马跳出来，消除稳患，又有过河卒助攻，黑方舒服。","ch":[{"m":"d0e1","cn":"仕六进五","ch":[{"m":"b3c3","cn":"车2平3","ch":[{"m":"c2d0","cn":"马七退六","ch":[{"m":"c3b3","cn":"车3平2","ch":[{"m":"d0c2","cn":"马六进七","ch":[{"m":"b3c3","cn":"车2平3","c":"黑方一捉一闲，如双方不变作和。此着黑方可变着改走卒3进1，炮八平九，车2平3，马七退六，卒3平4，车八进四，卒4进l，黑卒往中心区域靠拢，有强烈攻势。","ch":[{"m":"b2b8","cn":"炮八进六","ch":[{"m":"f8f1","cn":"车6进7","ch":[{"m":"b0b2","cn":"车八进二","ch":[{"m":"f1g1","cn":"车6平7","ch":[{"m":"g2f4","cn":"马三进四","ch":[{"m":"h7h2","cn":"炮8进5","c":"黑抓住战机，发挥左炮潜在威力，瞄马占优。红第15回合改马三进二稍好些，以下车7退3，马二进一，象7进9，车三平二，炮8平7，兵三进一，车7平8，象三进一，车8退2，兵三平二，炮7进5，士五进四，炮7平5，象七进五，马3进4，还是黑方易走。","ch":[{"m":"b8b6","cn":"炮八退二","ch":[{"m":"c3c2","cn":"车3进1","c":"黑得子优，红如不退炮而改士五进四，炮8进2，士四退五，炮5进4，伏车吃心仕杀，接下马七进五，车7进1，车三平二，车3进3，士五退六，炮8平6，红难应付。 对于后手列炮采取横车窝心马阵式，先手方尚缺乏有效进攻手段，但可用回避的办法。红方急于伸右车过河，结果被黑出车捉炮，形成各攻一翼互有利弊的局面。后来红车吃卒逼黑马归心，却没有后续手段，好像扑了一个空。其实，红方可缓开右车来腾出时间，加快左翼出子速度。见第三着红方马八进七变例。"}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]},{"m":"b0c2","cn":"马八进七","ch":[{"m":"a9b9","cn":"车1平2","ch":[{"m":"a0b0","cn":"车九平八","ch":[{"m":"b9b3","cn":"车2进6","ch":[{"m":"b2a2","cn":"炮八平九","ch":[{"m":"b3c3","cn":"车2平3","c":"如图，如红接走车八进二，则相当于先手走成小列手炮，只是多跳一步马，更加有利。","ch":[{"m":"i0h0","cn":"车一平二","ch":[{"m":"h9g7","cn":"马8进7","ch":[{"m":"b0b2","cn":"车八进二","ch":[{"m":"c6c5","cn":"卒3进1","c":"第6回合红先开车捉炮老练，待黑跳正马后，再高车保马，然后退炮平七攻黑薄弱的3线。所以黑第6回合改炮8平6再跳正马为宜。","ch":[{"m":"f0e1","cn":"仕四进五","ch":[{"m":"i9h9","cn":"车9平8","ch":[{"m":"a2a1","cn":"炮九退一","ch":[{"m":"c3d3","cn":"车3平4","ch":[{"m":"a1c1","cn":"炮九平七","ch":[{"m":"d3d6","cn":"车4退3","c":"红第8回合补左士较好，必要时留出左马退路。黑第1O回合退车软，不如车4进2，炮七进四，马3进4，对攻。 至此，红方仍持先手，黑方局型受制。 以上是黑后手列炮窝心马，红方亦可采用。见相关变例。"}]}]}]}]}]}]}]}]}]}]}]}]}]},{"m":"i0h0","cn":"车一平二","ch":[{"m":"h9g7","cn":"马8进7","ch":[{"m":"g3g4","cn":"兵三进一","ch":[{"m":"i9h9","cn":"车9平8","ch":[{"m":"h0h6","cn":"车二进六","ch":[{"m":"b9b3","cn":"车2进6","ch":[{"m":"a0a1","cn":"车九进一","ch":[{"m":"b3c3","cn":"车2平3","ch":[{"m":"c2e1","cn":"马七退五","ch":[{"m":"c3c4","cn":"车3退1","ch":[{"m":"g0i2","cn":"相三进一","ch":[{"m":"f9e8","cn":"士6进5","ch":[{"m":"a1d1","cn":"车九平六","c":"稳健，也可走炮八平七牵制黑车，较有力量。","ch":[{"m":"e7f7","cn":"炮5平6","ch":[{"m":"d1d3","cn":"车六进二","ch":[{"m":"c4c5","cn":"车3退1","ch":[{"m":"e3e4","cn":"兵五进一","ch":[{"m":"c5f5","cn":"车3平6","c":"第11回合红车本可吃卒压马，但此车一直没动，就是想控制黑左翼，稳步进取。","ch":[{"m":"g2e3","cn":"马三进五","ch":[{"m":"h7i7","cn":"炮8平9","ch":[{"m":"h6h9","cn":"车二进三","ch":[{"m":"g7h9","cn":"马7退8","ch":[{"m":"e4e5","cn":"兵五进一","ch":[{"m":"f5f3","cn":"车6进2","ch":[{"m":"e2c2","cn":"炮五平七","c":"走兵五进一，保持中路攻势更好。","ch":[{"m":"f3i3","cn":"车6平9","ch":[{"m":"e5e6","cn":"兵五进一","ch":[{"m":"g9e7","cn":"象7进5","ch":[{"m":"e6f6","cn":"兵五平四","ch":[{"m":"f7h7","cn":"炮6平8","c":"红优，其中第16回合不卸炮而直走兵五进一，保持中路攻势更好。"}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]},{"m":"f9e8","cn":"士6进5","ch":[{"m":"b2b1","cn":"炮八退一","ch":[{"m":"h7i7","cn":"炮8平9","ch":[{"m":"h6g6","cn":"车二平三","ch":[{"m":"h9h7","cn":"车8进2","ch":[{"m":"g4g5","cn":"兵三进一","ch":[{"m":"i7i8","cn":"炮9退1","ch":[{"m":"g6f6","cn":"车三平四","ch":[{"m":"e7f7","cn":"炮5平6","c":"双方对攻。"}]}]}]}]}]}]}]}]}]}]},{"m":"b9b4","cn":"车2进5","ch":[{"m":"g0i2","cn":"相三进一","ch":[{"m":"h7i7","cn":"炮8平9","ch":[{"m":"h6g6","cn":"车二平三","ch":[{"m":"h9h7","cn":"车8进2","c":"黑第6回合骑河车欲吃兵制马，但红飞边相后阵势反而巩固，故黑此着不如改士6进5等一手，红车暂时不敢吃卒压马，因黑有炮8进4弃马陷车法。","ch":[{"m":"a0a1","cn":"车九进一","ch":[{"m":"c6c5","cn":"卒3进1","ch":[{"m":"a1d1","cn":"车九平六","ch":[{"m":"f9e8","cn":"士6进5","c":"补士是一步停着，既防止红车六进六捉马的威胁，又为以后卸中炮作了准备。如急于走炮9退1，红车三平四让一步，黑方反而难办。","ch":[{"m":"g4g5","cn":"兵三进一","ch":[{"m":"i7i8","cn":"炮9退1","ch":[{"m":"g6f6","cn":"车三平四","ch":[{"m":"e7f7","cn":"炮5平6","ch":[{"m":"d0e1","cn":"仕六进五","ch":[{"m":"i8f8","cn":"炮9平6","ch":[{"m":"f6i6","cn":"车四平一","ch":[{"m":"f7f1","cn":"前炮进6","ch":[{"m":"e1d0","cn":"仕五退六","ch":[{"m":"f1f7","cn":"前炮退6","c":"红第13回合补仕软，应车四退二邀兑车，设法保住过河兵优势。黑第15回合退炮是不得已，如改车8进6，车一平四，前炮平7，车四进二，炮7进1，士四进五，炮7平9，兵三进一，黑单车炮不成势，红得子占优。","ch":[{"m":"b2a2","cn":"炮八平九","ch":[{"m":"b4b3","cn":"车2进1","ch":[{"m":"g5g6","cn":"兵三进一","ch":[{"m":"g7h9","cn":"马7退8","c":"红方明显占优。 总之，本节介绍的列炮新局型，取得一些效果，但实例不多，有待进一步检脸与研究。"}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}],"title":"1320.列炮窝心马","category":"G","file":"G/013.json","plies":124,"vars":5,"annotated":true}